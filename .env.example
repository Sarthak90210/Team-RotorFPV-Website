# ─────────────────────────────────────────────────────────────
# FRONTEND environment variables (Vite)
# Copy this file to ".env" and fill in real values.
# Only VITE_-prefixed vars are exposed to the browser bundle.
# ─────────────────────────────────────────────────────────────

# Base URL of the backend API (the server/ Express app).
# Leave unset locally to default to http://localhost:3000.
VITE_API_URL=

# Firebase Web SDK config (Project Settings → General → Your apps → SDK setup).
# These are public client identifiers, not secrets — access is controlled by
# Firestore security rules and server-side token verification.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
