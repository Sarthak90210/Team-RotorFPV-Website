rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.admin == true;
    }

    function isSuperAdmin() {
      return request.auth != null
          && request.auth.token.superAdmin == true;
    }

    function isInventoryAdmin() {
      return request.auth != null && 
        (request.auth.token.admin == true || request.auth.token.superAdmin == true || request.auth.token.inventory == true);
    }

    match /achievements/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /gallery/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /team_members/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /team_years/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /sponsors/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /events/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /drones/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /contact_messages/{docId} {
      allow read, write: if isAdmin();
    }

    match /activity_logs/{docId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
    }

    match /audit_logs/{docId} {
      allow read, create: if isAdmin();
    }

    match /join_requests/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /users/{docId} {
      allow read: if isAdmin() || isInventoryAdmin() || (request.auth != null && request.auth.token.email.lower() == docId);
      allow create: if request.auth != null && request.auth.token.email.lower() == docId &&
        (!request.resource.data.keys().hasAny(['tags', 'permissions', 'isActive', 'isArchived']));
      allow update: if isSuperAdmin() ||
                    (isAdmin() && request.auth.token.email.lower() != docId) ||
                    (request.auth != null && request.auth.token.email.lower() == docId &&
                     !request.resource.data.diff(resource.data).affectedKeys().hasAny(['permissions', 'tags', 'isAdmin', 'isSuperAdmin', 'boardGroup']));
      allow delete: if isAdmin();
    }

    match /tags/{docId} {
      allow read, write: if isAdmin();
    }

    match /custom_fields/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /inventory_lists/{docId} {
      allow read, write: if isInventoryAdmin();
    }

    match /inventories/{docId} {
      allow read, write: if isInventoryAdmin();
    }

    match /items/{docId} {
      allow read, write: if isInventoryAdmin();
    }

    match /inventory_hold_history/{docId} {
      allow read, write: if isInventoryAdmin();
    }

    match /item_history/{docId} {
      allow read, write: if isInventoryAdmin();
    }

    match /inventory_movement_history/{docId} {
      allow read, write: if isInventoryAdmin();
    }

    match /social_links/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Physical QR asset tags. Gated to inventory admins, consistent with the
    // inventories/items collections. Enforces the tag lifecycle:
    //   unassigned -> active (bind, immutable binding) -> retired.
    // A bound tag can never be re-pointed; tags are retired, never deleted.
    // This also resolves the offline race: two devices binding the same
    // unassigned tag → first to reach the server wins, the second fails the
    // status == 'unassigned' precondition on sync.
    match /asset_tags/{code} {
      function isBindTransition() {
        return resource.data.status == 'unassigned'
          && request.resource.data.status == 'active'
          && request.resource.data.entityId != null
          && (request.resource.data.entityType == 'inventory'
              || request.resource.data.entityType == 'item');
      }
      function isRetireTransition() {
        return resource.data.status == 'active'
          && request.resource.data.status == 'retired'
          && request.resource.data.entityId == resource.data.entityId
          && request.resource.data.entityType == resource.data.entityType;
      }
      allow read: if isInventoryAdmin();
      allow create: if isInventoryAdmin()
        && request.resource.data.status == 'unassigned'
        && request.resource.data.entityId == null
        && request.resource.data.entityType == null;
      allow update: if isInventoryAdmin() && (isBindTransition() || isRetireTransition());
      allow delete: if false;
    }

    // Deny everything else by default.
    // Any new collection must have explicit rules added above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
