rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.admin == true;
    }

    function isSuperAdmin() {
      return request.auth != null
          && request.auth.token.superAdmin == true;
    }

    match /achievements/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /gallery/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /team_members/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /team_years/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /sponsors/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /events/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /drones/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /contact_messages/{docId} {
      allow read, write: if isAdmin();
    }

    match /activity_logs/{docId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
    }

    match /audit_logs/{docId} {
      allow read, create: if isAdmin();
    }

    match /join_requests/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /users/{docId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email.lower() == docId);
      allow create: if request.auth != null && request.auth.token.email.lower() == docId &&
        (!request.resource.data.keys().hasAny(['tags', 'permissions', 'isActive', 'isArchived']));
      allow update: if isSuperAdmin() ||
                    (isAdmin() && request.auth.token.email.lower() != docId) ||
                    (request.auth != null && request.auth.token.email.lower() == docId &&
                     !request.resource.data.diff(resource.data).affectedKeys().hasAny(['permissions', 'tags', 'isAdmin', 'isSuperAdmin', 'boardGroup']));
      allow delete: if isAdmin();
    }

    match /tags/{docId} {
      allow read, write: if isAdmin();
    }

    match /custom_fields/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /inventory_lists/{docId} {
      allow read, write: if isAdmin();
    }

    match /inventories/{docId} {
      allow read, write: if isAdmin();
    }

    match /items/{docId} {
      allow read, write: if isAdmin();
    }

    match /inventory_hold_history/{docId} {
      allow read, write: if isAdmin();
    }

    match /item_history/{docId} {
      allow read, write: if isAdmin();
    }

    match /inventory_movement_history/{docId} {
      allow read, write: if isAdmin();
    }

    // Deny everything else by default.
    // Any new collection must have explicit rules added above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
