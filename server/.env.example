# ─────────────────────────────────────────────────────────────
# BACKEND environment variables (server/ Express app)
# Copy this file to "server/.env" and fill in real values.
# This file is committed; the real "server/.env" is gitignored.
# ─────────────────────────────────────────────────────────────

# Port the server listens on (defaults to 3000 if unset).
PORT=3000

# ── CORS ──
# Production frontend origin (e.g. https://teamrotorfpv.com).
FRONTEND_URL=
# Vercel project slug, to allow that project's preview deployments through CORS
# (e.g. team-rotor-fpv-website). Leave blank to disable preview-URL allowance.
VERCEL_PROJECT_NAME=

# ── Firebase Admin SDK ──
# Full service-account JSON as a single line (Project Settings → Service Accounts
# → Generate new private key). In local dev you can instead drop the file at
# server/serviceAccountKey.json and leave this blank.
FIREBASE_SERVICE_ACCOUNT=

# Root super-admin email. This account can never be demoted/removed and is the
# fallback super-admin if custom claims are missing.
SUPER_ADMIN_EMAIL=

# ── Cloudinary (image/video uploads) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Supabase Storage (large 3D .glb/.gltf model uploads) ──
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# SERVICE ROLE key (Project Settings → API → service_role). Server-only secret —
# never expose to the browser. Bypasses storage RLS for admin uploads.
SUPABASE_SERVICE_ROLE_KEY=
# Public bucket name for models (defaults to "drone-models" if unset).
SUPABASE_BUCKET=drone-models

# ── Resend (contact-form email notifications) ──
RESEND_API_KEY=
# Verified sender address on your Resend domain.
# Optional — defaults to "Team RotorFPV <contact@teamrotorfpv.com>".
CONTACT_FROM=
# Comma-separated list of inboxes that receive contact-form submissions.
# In Resend test mode (no verified domain) only your Resend account email is
# deliverable, so set that here for local testing.
CONTACT_RECIPIENTS=teamrotorfpv@vit.ac.in
